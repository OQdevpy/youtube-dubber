# Copy to backend/.env and fill in. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: any Gemini model id available to your key
GEMINI_MODEL=gemini-3.6-flash
# low = fast start (default); minimal / medium / high also work on Gemini 3.x
GEMINI_THINKING=low

# Optional: ElevenLabs voices (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
# The key needs "Text to Speech: Access"; "Voices: Read" lets the app list your own voices
# Parallel ElevenLabs requests; keep at or below your plan's concurrency limit
ELEVENLABS_CONCURRENCY=2

# Optional: ElevenLabs speech-to-text model (the key needs "Speech to Text: Access")
ELEVENLABS_STT_MODEL=scribe_v2

# --- Running on a server -----------------------------------------------------
# Password for the whole site (browser asks for it). STRONGLY recommended on a
# public server: every dub spends your Gemini / ElevenLabs credits.
DUB_USER=dublyaj
DUB_PASSWORD=
# YouTube blocks many datacenter IPs. If you get YOUTUBE_BLOCKED on a VPS,
# route YouTube requests through a proxy: http://user:pass@host:port
YOUTUBE_PROXY=
# Or, for "Ovozdan matn" (speech-to-text) only: a cookies.txt exported from a
# browser logged in to YouTube (use a spare account). Put the file at
# backend/cookies.txt; docker-compose mounts it at /app/cookies.txt.
YOUTUBE_COOKIES=
